# Copy to .env (Docker Compose) or backend/.env (running uvicorn directly).

# Leave empty to use the offline demo matcher. Never commit a real key.
OPENAI_API_KEY=
# "openai" or "demo"; empty picks openai when a key is set, demo otherwise.
LLM_MODE=
OPENAI_MODEL=gpt-4o-mini

# Prompt/response pairs are stored here when the OpenAI mode is used.
DATABASE_URL=sqlite:///./data/llmdatabase.db
STORE_PROMPTS=true

MAX_UPLOAD_BYTES=2097152
MAX_COLUMNS=200
SCRIPT_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
